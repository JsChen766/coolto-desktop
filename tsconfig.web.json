{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/desktop/renderer/src/*"],
      "@desktop/*": ["src/desktop/shared/*"]
    }
  },
  "include": [
    "src/desktop/renderer/**/*.ts",
    "src/desktop/renderer/**/*.vue",
    "src/desktop/shared/**/*.ts"
  ]
}
