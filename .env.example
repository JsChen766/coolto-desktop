# Optional bootstrap for the first launch. After that, Settings → AI provider
# stores the key in the OS credential store. Do not commit a real key.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Optional. Caps completion max_tokens for OpenAI-compatible hosts
# that reject the DeepSeek template default (384000). Default ceiling: 65536.
# LLM_MAX_TOKENS=8192
