{
  "name": "coolto-local-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "description": "Local single-agent runtime for the Coolto desktop app",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import tsx src/cli/main.ts",
    "sync:resume-template": "node scripts/sync-resume-template-assets.mjs",
    "check:resume-template": "node scripts/sync-resume-template-assets.mjs --check",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "electron-vite build",
    "desktop:preview": "electron-vite preview",
    "desktop:typecheck": "tsc -p tsconfig.preload.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "qa:resume-renderer": "npm run desktop:build && node scripts/run-resume-renderer-qa.mjs",
    "smoke:resume-source": "node --import tsx scripts/run-resume-source-smoke.ts",
    "eval:resume-agent": "node --import tsx scripts/run-resume-agent-eval.ts",
    "qa:p0-single-resume-live": "node --import tsx scripts/run-p0-single-resume-live.ts",
    "logout": "node --import tsx src/cli/logout.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run check:resume-template && npm run typecheck && npm run desktop:typecheck && npm run test && npm run build && npm run desktop:build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1",
    "@lucide/vue": "^1.26.0",
    "@napi-rs/keyring": "^1.3.0",
    "dompurify": "^3.4.12",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.3.0",
    "marked": "^18.0.7",
    "pdfjs-dist": "^6.1.200",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vue-tsc": "^3.3.8"
  }
}
