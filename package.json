{
  "name": "coolto-local-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local single-agent runtime for the Coolto desktop app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
