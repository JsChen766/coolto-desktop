import { request, buildQuery } from './client'
import { postSse } from './sse'
import type { BrowserLayoutObservation } from '../utils/resume-dom-measurement'
import type { CoverageReport, EditDiff, ResumeStructure } from '../types/generated-content'

export interface Resume {
  id: string
  title: string
  targetRole: string | null
  jdId: string | null
  activeVariantId: string | null
  status: string
  createdAt: string
  updatedAt: string
}

export interface ResumeItem {
  id: string
  resumeId: string
  sectionType: string
  title: string | null
  contentSnapshot: string
  orderIndex: number
  hidden: boolean
  pinned: boolean
  sourceExperienceId: string | null
  sourceVariantId: string | null
  updatedAt: string
}

export interface ResumeVariant {
  id: string
  title: string
  content: string
  score: {
    overall: number
    relevance: number
    clarity: number
    evidenceStrength: number
    quantifiedImpact: number
  }
  evidenceSummary: Array<{
    requirementId: string
    requirementText: string
    supportingClaims: string[]
    matchScore: number
  }>
  riskSummary: Array<{
    type: string
    text: string
    severity: string
  }>
  missingInfo: string[]
  structured?: ResumeStructure | null
  coverageReport?: CoverageReport | null
  parentVariantId?: string | null
  version?: number
  gateStatus?: 'unverified' | 'passed' | 'needs_revision' | 'failed'
  publicationStatus?: 'staged' | 'published' | 'discarded'
  createdAt: string
}

export interface ReplaceStructuredResult {
  variantId: string
  structured: ResumeStructure
  content: string
  version: number
  parentVariantId: string | null
  gateStatus: 'unverified' | 'passed' | 'needs_revision' | 'failed'
  qualityStatus: 'pass' | 'needs_revision'
  layoutReport: Record<string, unknown>
}

export interface ResumeFull extends Resume {
  items: ResumeItem[]
  variants: ResumeVariant[]
}

export interface ResumeAiEditMessage {
  role: 'user' | 'assistant'
  content: string
}

export interface ResumeAiEditTarget {
  sectionId?: string
  itemId?: string
  bulletId?: string
}

export interface ResumeAiEditRequest {
  baseVariantId: string
  message: string
  messageContext?: string
  target?: ResumeAiEditTarget
  repairAttempt?: number
  ephemeralContext?: ResumeAiEditMessage[]
}

export interface ResumeAiEditProposalEvent {
  event: 'resume.edit.proposal'
  resume_id: string
  base_variant_id: string
  proposal_id: string
  structured: ResumeStructure
  content: string
  diff: EditDiff
  layout_report: Record<string, unknown> | null
  estimated_quality_status: string
  browser_verification_status: 'pending'
  repair_attempt: number
  content_review: {
    decision?: 'pass' | 'revise' | 'reject'
    issues?: string[]
  }
}

export interface ResumeAiEditNoProposalEvent {
  event: 'resume.edit.no_proposal'
  code: string
  message: string
  retryable: boolean
  suggested_action: 'retry' | 'select_target' | 'refresh' | 'none'
}

export type ResumeAiEditSseEvent = ResumeAiEditProposalEvent | {
  event?: string
  error?: { code?: string; message?: string; node?: string | null }
  [key: string]: unknown
}

export interface ResumeAiEditViolation {
  code: string
  message: string
  bullet_id?: string | null
  retryable: boolean
}

export interface ResumeAiEditVerification {
  proposalId: string
  status: 'passed' | 'needs_revision' | 'failed'
  canAccept: boolean
  canRetry: boolean
  canRemeasure: boolean
  nextRepairAttempt: number | null
  repairBaseVariantId: string | null
  repairInstruction: string | null
  repairableBulletIds: string[]
  violations: ResumeAiEditViolation[]
  pageUsageRatio: number
}

export interface ResumeAiEditAcceptResult {
  resumeId: string
  activeVariantId: string
  variant: ResumeVariant
}

export interface ResumeAiEditRejectResult {
  resumeId: string
  proposalId: string
  status: 'discarded'
}

export interface ResumeAiEditReviseResult {
  proposalId: string
  structured: ResumeStructure
  content: string
  gateStatus: 'unverified'
  publicationStatus: 'staged'
}

export interface ResumeListResult {
  items: Resume[]
  nextCursor: string | null
}

export interface CreateResumeBody {
  title: string
  targetRole?: string
  jdId?: string
}

export interface UpdateResumeBody {
  title?: string
  targetRole?: string
  jdId?: string
  status?: string
}

export interface AddItemBody {
  sectionType: string
  title?: string
  contentSnapshot?: string
  orderIndex?: number
  sourceExperienceId?: string
}

export interface UpdateItemBody {
  sectionType?: 'summary' | 'experience' | 'education' | 'skills' | 'projects' | 'other'
  title?: string
  contentSnapshot?: string
  orderIndex?: number
  hidden?: boolean
  pinned?: boolean
}

function listResumes(limit = 20, cursor?: string): Promise<ResumeListResult> {
  const qs = buildQuery({ limit, cursor })
  return request<ResumeListResult>(`/v1/product/resumes${qs}`)
}

function createResume(body: CreateResumeBody): Promise<Resume> {
  return request<Resume>('/v1/product/resumes', { method: 'POST', data: body })
}

function getResume(resumeId: string): Promise<ResumeFull> {
  return request<ResumeFull>(`/v1/product/resumes/${resumeId}`)
}

function updateResume(resumeId: string, body: UpdateResumeBody): Promise<Resume> {
  return request<Resume>(`/v1/product/resumes/${resumeId}`, { method: 'PATCH', data: body })
}

function addItem(resumeId: string, body: AddItemBody): Promise<ResumeItem> {
  return request<ResumeItem>(`/v1/product/resumes/${resumeId}/items`, { method: 'POST', data: body })
}

function updateItem(itemId: string, body: UpdateItemBody): Promise<ResumeItem> {
  return request<ResumeItem>(`/v1/product/resume-items/${itemId}`, { method: 'PATCH', data: body })
}

function deleteItem(itemId: string): Promise<{ deleted: boolean }> {
  return request<{ deleted: boolean }>(`/v1/product/resume-items/${itemId}`, { method: 'DELETE' })
}

function reorderItems(resumeId: string, orderedIds: string[]): Promise<ResumeItem[]> {
  return request<ResumeItem[]>(`/v1/product/resumes/${resumeId}/reorder`, {
    method: 'POST',
    data: { ordered_ids: orderedIds },
  })
}

function replaceVariantStructured(
  resumeId: string,
  variantId: string,
  structured: ResumeStructure,
): Promise<ReplaceStructuredResult> {
  return request<ReplaceStructuredResult>(
    `/v1/product/resumes/${resumeId}/variants/${variantId}/structured`,
    { method: 'PUT', data: { structured } },
  )
}

function streamAiEdit(
  resumeId: string,
  body: ResumeAiEditRequest,
  onEvent: (event: ResumeAiEditSseEvent) => void,
  onDone: () => void,
  onError: (error: unknown) => void,
): AbortController {
  return postSse<ResumeAiEditSseEvent>(
    `/v1/product/resumes/${resumeId}/ai-edits/stream`,
    body,
    onEvent,
    onDone,
    onError,
  )
}

function verifyAiEditLayout(
  resumeId: string,
  proposalId: string,
  observation: BrowserLayoutObservation,
  repairAttempt: number,
): Promise<ResumeAiEditVerification> {
  return request<ResumeAiEditVerification>(
    `/v1/product/resumes/${resumeId}/ai-edits/${proposalId}/verify-layout`,
    { method: 'POST', data: { observation, repairAttempt }, timeout: 60000 },
  )
}

function acceptAiEdit(resumeId: string, proposalId: string): Promise<ResumeAiEditAcceptResult> {
  return request<ResumeAiEditAcceptResult>(
    `/v1/product/resumes/${resumeId}/ai-edits/${proposalId}/accept`,
    { method: 'POST', timeout: 60000 },
  )
}

function rejectAiEdit(resumeId: string, proposalId: string): Promise<ResumeAiEditRejectResult> {
  return request<ResumeAiEditRejectResult>(
    `/v1/product/resumes/${resumeId}/ai-edits/${proposalId}/reject`,
    { method: 'POST', timeout: 60000 },
  )
}

function reviseAiEdit(
  resumeId: string,
  proposalId: string,
  structured: ResumeStructure,
): Promise<ResumeAiEditReviseResult> {
  return request<ResumeAiEditReviseResult>(
    `/v1/product/resumes/${resumeId}/ai-edits/${proposalId}/structured`,
    { method: 'PUT', data: { structured }, timeout: 60000 },
  )
}

export const resumesApi = {
  listResumes, createResume, getResume, updateResume,
  addItem, updateItem, deleteItem, reorderItems, replaceVariantStructured,
  streamAiEdit, verifyAiEditLayout, acceptAiEdit, rejectAiEdit, reviseAiEdit,
}
