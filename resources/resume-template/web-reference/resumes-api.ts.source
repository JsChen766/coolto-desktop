import { request, buildQuery } from './client'
import { postSse } from './sse'
import type { BrowserLayoutObservation } from '../utils/resume-dom-measurement'
import type { EditDiff, ResumeStructure } from '../types/generated-content'

export interface Resume {
  id: string
  title: string
  targetRole: string | null
  jdId: string | null
  contentHash: string
  schemaVersion: string
  qualityStatus: 'unverified' | 'passed' | 'needs_revision' | 'failed'
  status: 'draft' | 'active' | 'published' | 'archived'
  createdAt: string
  updatedAt: string
}

export interface ResumeFull extends Resume {
  structured: ResumeStructure
  content: string
  score: {
    overall: number
    relevance: number
    clarity: number
    evidence_strength: number
    quantified_impact: number
  }
  evidenceSummary: Array<{
    requirement_id: string
    requirement_text: string
    supporting_claims: string[]
    match_score: number
  }>
  riskSummary: Array<{ type: string; text: string; severity: string }>
  missingInfo: string[]
  qualityIssues: Array<Record<string, unknown>>
  qualityGateVersion: string | null
}

export interface ResumeAiEditMessage {
  role: 'user' | 'assistant'
  content: string
}

export interface ResumeAiEditTarget {
  sectionId?: string
  itemId?: string
  bulletId?: string
}

export interface ResumeAiEditRequest {
  baseContentHash: string
  message: string
  messageContext?: string
  target?: ResumeAiEditTarget
  repairAttempt?: number
  ephemeralContext?: ResumeAiEditMessage[]
}

export interface ResumeAiEditProposalEvent {
  event: 'resume.edit.proposal'
  resume_id: string
  base_content_hash: string
  proposal_id: string
  structured: ResumeStructure
  content: string
  diff: EditDiff
  layout_report: Record<string, unknown> | null
  estimated_quality_status: string
  browser_verification_status: 'pending'
  repair_attempt: number
  content_review: {
    decision?: 'pass' | 'revise' | 'reject'
    issues?: string[]
  }
}

export interface ResumeAiEditNoProposalEvent {
  event: 'resume.edit.no_proposal'
  code: string
  message: string
  retryable: boolean
  suggested_action: 'retry' | 'select_target' | 'refresh' | 'none'
}

export type ResumeAiEditSseEvent = ResumeAiEditProposalEvent | {
  event?: string
  error?: { code?: string; message?: string; node?: string | null }
  [key: string]: unknown
}

export interface ResumeAiEditViolation {
  code: string
  message: string
  bullet_id?: string | null
  retryable: boolean
}

export interface ResumeAiEditVerification {
  proposalId: string
  status: 'passed' | 'needs_revision' | 'failed'
  canAccept: boolean
  canRetry: boolean
  canRemeasure: boolean
  nextRepairAttempt: number | null
  repairBaseContentHash: string | null
  repairInstruction: string | null
  repairableBulletIds: string[]
  violations: ResumeAiEditViolation[]
  pageUsageRatio: number
}

export interface ResumeAiEditRejectResult {
  resumeId: string
  proposalId: string
  status: 'discarded'
}

export interface ResumeAiEditReviseResult {
  proposalId: string
  structured: ResumeStructure
  content: string
  qualityStatus: 'unverified'
}

export interface ResumeListResult {
  items: Resume[]
  nextCursor: string | null
}

export interface CreateResumeBody {
  title: string
  structured: ResumeStructure
  targetRole?: string
  jdId?: string
  status?: Resume['status']
}

export interface ReplaceResumeBody {
  structured: ResumeStructure
  expectedContentHash?: string
  title?: string
  targetRole?: string
  jdId?: string
  status?: Resume['status']
}

export interface UpdateResumeBody {
  title?: string
  targetRole?: string
  jdId?: string
  status?: Resume['status']
}

function listResumes(limit = 20, cursor?: string): Promise<ResumeListResult> {
  const qs = buildQuery({ limit, cursor })
  return request<ResumeListResult>(`/v1/product/resumes${qs}`)
}

function createResume(body: CreateResumeBody): Promise<ResumeFull> {
  return request<ResumeFull>('/v1/product/resumes', { method: 'POST', data: body })
}

function getResume(resumeId: string): Promise<ResumeFull> {
  return request<ResumeFull>(`/v1/product/resumes/${resumeId}`)
}

function replaceResume(resumeId: string, body: ReplaceResumeBody): Promise<ResumeFull> {
  return request<ResumeFull>(`/v1/product/resumes/${resumeId}`, { method: 'PUT', data: body })
}

function updateResume(resumeId: string, body: UpdateResumeBody): Promise<ResumeFull> {
  return request<ResumeFull>(`/v1/product/resumes/${resumeId}`, { method: 'PATCH', data: body })
}

function streamAiEdit(
  resumeId: string,
  body: ResumeAiEditRequest,
  onEvent: (event: ResumeAiEditSseEvent) => void,
  onDone: () => void,
  onError: (error: unknown) => void,
): AbortController {
  return postSse<ResumeAiEditSseEvent>(
    `/v1/product/resumes/${resumeId}/ai-edits/stream`, body, onEvent, onDone, onError,
  )
}

function verifyAiEditLayout(
  resumeId: string,
  proposalId: string,
  observation: BrowserLayoutObservation,
  repairAttempt: number,
): Promise<ResumeAiEditVerification> {
  return request<ResumeAiEditVerification>(
    `/v1/product/resumes/${resumeId}/ai-edits/${proposalId}/verify-layout`,
    { method: 'POST', data: { observation, repairAttempt }, timeout: 60000 },
  )
}

function acceptAiEdit(resumeId: string, proposalId: string): Promise<ResumeFull> {
  return request<ResumeFull>(
    `/v1/product/resumes/${resumeId}/ai-edits/${proposalId}/accept`,
    { method: 'POST', timeout: 60000 },
  )
}

function rejectAiEdit(resumeId: string, proposalId: string): Promise<ResumeAiEditRejectResult> {
  return request<ResumeAiEditRejectResult>(
    `/v1/product/resumes/${resumeId}/ai-edits/${proposalId}/reject`,
    { method: 'POST', timeout: 60000 },
  )
}

function reviseAiEdit(
  resumeId: string,
  proposalId: string,
  structured: ResumeStructure,
): Promise<ResumeAiEditReviseResult> {
  return request<ResumeAiEditReviseResult>(
    `/v1/product/resumes/${resumeId}/ai-edits/${proposalId}/structured`,
    { method: 'PUT', data: { structured }, timeout: 60000 },
  )
}

export const resumesApi = {
  listResumes,
  createResume,
  getResume,
  replaceResume,
  updateResume,
  streamAiEdit,
  verifyAiEditLayout,
  acceptAiEdit,
  rejectAiEdit,
  reviseAiEdit,
}
