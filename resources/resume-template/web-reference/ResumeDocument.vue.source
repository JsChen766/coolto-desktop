.resume-document-contact { display: flex; justify-content: center; gap: var(--resume-contact-gap); margin-top: 0; font-size: var(--resume-contact-font-size); font-weight: var(--resume-contact-font-weight); line-height: var(--resume-contact-line-height); white-space: nowrap; }
.resume-document-link { color: #0000ee; text-decoration: underline; }
